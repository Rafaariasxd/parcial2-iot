{
  "version": 1,
  "author": "Rafael Arias Monsalve",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -95, "left": 150, "attrs": { "temperature": "27.5", "humidity": "70" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr", "top": 150, "left": 150, "attrs": {} },
    { "type": "wokwi-led", "id": "led", "top": 60, "left": -90, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 130, "left": -100, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.2", "black", [] ],
    [ "dht:SDA", "esp:15", "green", [] ],
    [ "ldr:VCC", "esp:3V3", "red", [] ],
    [ "ldr:GND", "esp:GND.1", "black", [] ],
    [ "ldr:AO", "esp:34", "orange", [] ],
    [ "led:A", "esp:26", "green", [] ],
    [ "led:C", "r1:1", "black", [] ],
    [ "r1:2", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
